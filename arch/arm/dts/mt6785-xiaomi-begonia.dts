/dts-v1/;
#include "mt6785.dtsi"

/ {
	model = "Xiaomi Redmi Note 8 Pro";
	compatible = "xiaomi,begonia", "mediatek,mt6785";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&pwrap {
	pmic {
		compatible = "mediatek,mt6359";

		regulators {
			compatible = "mediatek,mt6359-regulator";
		};
	};
};

&uart0 {
	status = "okay";
};
