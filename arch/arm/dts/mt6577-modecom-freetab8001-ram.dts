/dts-v1/;

/ {
	model = "MODECOM FreeTAB 8001 RAM bring-up";
	compatible = "modecom,freetab8001", "mediatek,mt6577";
	#address-cells = <1>;
	#size-cells = <1>;

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x04000000>;
	};

	clk13m: clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <13000000>;
		bootph-all;
	};

	msdc_clock: clock-msdc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <197000000>;
	};

	mmc@c1220000 {
		compatible = "mediatek,mt6577-mmc-ram";
		reg = <0xc1220000 0x1000>;
		clocks = <&msdc_clock>;
		clock-names = "source";
		bus-width = <4>;
		max-frequency = <12000000>;
		non-removable;
	};

	timer@c1002000 {
		compatible = "mediatek,mt6577-timer";
		reg = <0xc1002000 0x100>;
		clocks = <&clk13m>;
		bootph-all;
	};

	usb@c1210000 {
		compatible = "mediatek,mt6577-musb-ram";
		reg = <0xc1210000 0x1000>;
		dr_mode = "peripheral";
	};
};
