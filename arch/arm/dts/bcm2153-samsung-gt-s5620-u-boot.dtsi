/ {
	stock-lcd@8030000 {
		compatible = "samsung,gt-s5620-stock-lcd";
		reg = <0x08030000 0x20>;
		bootph-all;
	};
};

&osc32k {
	bootph-all;
};

&gpt {
	bootph-all;
	status = "okay";
};

&bsc0 {
	status = "okay";
};

&hcldo2 {
	regulator-always-on;
};

&sd1 {
	status = "okay";
};
