CONFIG_ARM=y
CONFIG_TARGET_SAMSUNG_J320F=y
CONFIG_TEXT_BASE=0x80008000
CONFIG_SYS_MALLOC_LEN=0x200000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x85300000
CONFIG_DEFAULT_DEVICE_TREE="sc9830-samsung-j320f"
CONFIG_SYS_LOAD_ADDR=0x81000000
CONFIG_SYS_DCACHE_OFF=y
CONFIG_SYS_L2CACHE_OFF=y
# CONFIG_ARMV7_NONSEC is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fastboot usb 0"
CONFIG_BOOTDELAY=0
CONFIG_BOARD_LATE_INIT=y
CONFIG_DM_REBOOT_MODE=y
CONFIG_HUSH_PARSER=y
CONFIG_CMD_GETTIME=y
CONFIG_CMD_BOOTZ=y
CONFIG_SUPPORT_RAW_INITRD=y
# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_SYSRESET=y
# CONFIG_NET is not set
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
CONFIG_USB=y
CONFIG_DM_USB=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DWC2_OTG=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_VENDOR_NUM=0x1209
CONFIG_USB_GADGET_PRODUCT_NUM=0x4a33
CONFIG_USB_GADGET_MANUFACTURER="J320F U-Boot development"
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CONSOLE_RECORD=y
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
CONFIG_FASTBOOT_BUF_ADDR=0x81000000
CONFIG_FASTBOOT_BUF_SIZE=0x04000000
